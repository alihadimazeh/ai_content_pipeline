<h1 class="auth-heading">Welcome back</h1>
<p class="auth-sub">Sign in to your Pipeline account.</p>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
  <div class="field">
    <%= f.label :email, class: "field-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input", placeholder: "you@example.com" %>
  </div>

  <div class="field">
    <%= f.label :password, class: "field-label" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "input", placeholder: "••••••••" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <label class="auth-remember">
      <%= f.check_box :remember_me, class: "auth-checkbox" %>
      <span>Remember me</span>
    </label>
  <% end %>

  <%= f.submit "Sign in", class: "auth-submit" %>
<% end %>

<p class="auth-switch">
  Don't have an account?
  <%= link_to "Sign up", new_user_registration_path, class: "auth-link" %>
</p>

<% if devise_mapping.recoverable? %>
  <p class="auth-switch">
    <%= link_to "Forgot your password?", new_user_password_path, class: "auth-link" %>
  </p>
<% end %>
