<div id="<%= dom_id(generated_content) %>" class="border rounded p-5">
  <h2 class="font-semibold text-sm uppercase tracking-wide text-gray-500 mb-3">
    <%= generated_content.format.humanize %>
  </h2>

  <% if generated_content.status == "complete" %>
    <div data-controller="clipboard">
      <div data-clipboard-target="source" class="prose prose-sm max-w-none text-sm"><%= render_markdown(generated_content.body) %></div>
      <div class="flex gap-2 mt-3">
        <button data-clipboard-target="button" data-action="clipboard#copy" class="btn btn-secondary">Copy</button>
        <%= button_to "Regenerate", retry_pipeline_generated_content_path(generated_content.pipeline, generated_content), method: :post, class: "btn btn-primary" %>
      </div>
    </div>
  <% elsif generated_content.status == "failed" %>
    <p class="text-red-500 text-sm">Generation failed.</p>
    <%= button_to "Retry", retry_pipeline_generated_content_path(generated_content.pipeline, generated_content), method: :post, class: "btn btn-primary" %>
  <% else %>
    <div class="flex items-center gap-2 text-sm text-gray-400">
      <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
      Generating…
    </div>
  <% end %>
</div>
