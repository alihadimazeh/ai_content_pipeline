<div id="<%= dom_id(generated_content) %>"
     class="result-card is-<%= generated_content.status %>"
     style="--tile-hue: <%= format_hue(generated_content.format) %>"
     <%= "data-controller=clipboard" if generated_content.status == "complete" %>>

  <%# Header %>
  <div class="result-card-header">
    <div class="result-card-header-icon">
      <%= format_icon(generated_content.format) %>
    </div>
    <span class="result-card-title"><%= generated_content.format.humanize %></span>
    <div class="result-card-meta">
      <span class="result-card-version">v<%= generated_content.version %></span>
      <%= status_chip(generated_content.status) %>
    </div>
  </div>

  <%# Body %>
  <div class="result-card-body">
    <% if generated_content.status == "complete" %>
      <div class="result-body-enter">
        <div data-clipboard-target="source" class="prose">
          <%= render_markdown(generated_content.body) %>
        </div>
      </div>
    <% elsif generated_content.status == "failed" %>
      <div class="flex items-center gap-2.5 text-[var(--danger)] py-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.3 3.9 2.4 17.6A2 2 0 0 0 4.1 20.6h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>
          <path d="M12 9v4M12 17h.01"/>
        </svg>
        <span class="text-sm">Generation failed.</span>
      </div>
    <% else %>
      <div class="skeleton-lines">
        <% ["w-4/5", "w-[95%]", "w-3/5", "w-[90%]", "w-3/4", "w-[88%]", "w-[55%]"].each do |w| %>
          <div class="skeleton-line <%= w %>"></div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Footer %>
  <div class="result-card-footer">
    <span class="tone-pill">Tone · <%= generated_content.pipeline.tone&.humanize || "—" %></span>
    <div class="spacer"></div>
    <% if generated_content.status == "complete" %>
      <button data-clipboard-target="button" data-action="clipboard#copy" class="btn btn-ghost btn-sm">Copy</button>
      <%= button_to "Regenerate", retry_pipeline_generated_content_path(generated_content.pipeline, generated_content), method: :post, class: "btn btn-secondary btn-sm" %>
    <% elsif generated_content.status == "failed" %>
      <%= button_to "Retry", retry_pipeline_generated_content_path(generated_content.pipeline, generated_content), method: :post, class: "btn btn-secondary btn-sm" %>
    <% end %>
  </div>

</div>
