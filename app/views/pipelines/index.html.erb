<div>
  <div class="my-4">
    <h1>Your Pipelines</h1>
    <%= link_to "New Pipeline", new_pipeline_path %>
  </div>

  <% if @pipelines.empty? %>
    <p>No pipelines yet. <%= link_to "Create one", new_pipeline_path %>.</p>
  <% else %>
    <ul>
      <% @pipelines.each do |pipeline| %>
        <li>
          <div>
            <div class="mb-4 p-4 shadow-lg w-1/3 rounded-lg">
              <h2 class="text-2xl mb-2 font-bold">Topic</h2>
              <p><%= pipeline.topic %></p>
              <h2>Formats</h2>
              <p><%= pipeline.formats.join(", ") %></p>
              <span><%= pipeline.created_at.strftime("%b %d, %Y") %></span>
              <%= link_to "View", pipeline_path(pipeline) %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
