<%= turbo_stream_from @pipeline %>

<% content_for :breadcrumbs do %>
  <%= link_to "Dashboard", pipelines_path %>
  <span class="sep">/</span>
  <span class="here"><%= truncate(@pipeline.topic, length: 40) %></span>
<% end %>

<div class="page">
  <%# Page header %>
  <div style="margin-bottom: 28px;">
    <p style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); margin-bottom: 6px;">Topic</p>
    <h1 class="page-title">"<%= @pipeline.topic %>"</h1>
    <p class="page-sub" style="margin-top: 10px;">
      Tone · <%= @pipeline.tone&.humanize || "—" %>
      &nbsp;·&nbsp;
      <%= @pipeline.created_at.strftime("%B %d, %Y") %>
      &nbsp;·&nbsp;
      <%= @pipeline.formats.size %> <%= "format".pluralize(@pipeline.formats.size) %>
    </p>
  </div>

  <%# Results grid %>
  <% if @pipeline.generated_contents.empty? %>
    <p style="color: var(--ink-3);">No content generated yet.</p>
  <% else %>
    <div class="results-grid">
      <% @pipeline.generated_contents.each do |content| %>
        <%= render "generated_content", generated_content: content %>
      <% end %>
    </div>
  <% end %>
</div>
