<%= turbo_stream_from @pipeline %>
<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← All Pipelines", pipelines_path, class: "text-sm text-gray-500 hover:underline" %>
  </div>

  <h1 class="text-2xl font-bold mb-1"><%= @pipeline.topic %></h1>
  <p class="text-sm text-gray-400 mb-8"><%= @pipeline.created_at.strftime("%B %d, %Y") %></p>

  <div class="space-y-6">
    <% if @pipeline.generated_contents.empty? %>
      <div>
        <p>You don't have any generated content yet</p>
      </div>
    <%  else  %>
      <%  @pipeline.generated_contents.each do |content|  %>
        <%=  render "generated_content", generated_content: content  %>
      <%  end  %>
    <%  end %>
  </div>
</div>
<%= console %>