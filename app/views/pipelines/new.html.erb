<% content_for :breadcrumbs do %>
  <%= link_to "Dashboard", pipelines_path %>
  <span class="sep">/</span>
  <span class="here">New pipeline</span>
<% end %>

<div class="page narrow">
  <div class="page-header">
    <div>
      <h1 class="page-title">Start a new pipeline</h1>
      <p class="page-sub">One topic, multiple formats. Results stream in as each job completes.</p>
    </div>
  </div>

  <% if @pipeline.errors.any? %>
    <div class="form-errors">
      <% @pipeline.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div class="card card-pad-lg">
    <%= form_with url: pipelines_path, html: { autocomplete: "off" } do |f| %>
      <div class="flex flex-col gap-6">

        <%# Topic %>
        <div class="field">
          <label class="field-label">Topic</label>
          <%= text_field_tag "pipeline[topic]", @pipeline.topic,
                placeholder: "e.g. why small teams ship faster, the case for writing things down…",
                class: "input xl" %>
          <span class="field-hint">Be specific. A tight topic produces tighter output.</span>
        </div>

        <%# Tone %>
        <div class="field">
          <div class="flex items-center justify-between">
            <label class="field-label">Tone</label>
            <span class="field-hint">Passed into every prompt</span>
          </div>
          <div class="segmented" data-controller="segmented" data-action="change->segmented#update">
            <% [["Professional", "professional"], ["Casual", "casual"], ["Witty", "witty"], ["Academic", "academic"]].each do |label, value| %>
              <label>
                <input type="radio" name="pipeline[tone]" value="<%= value %>"
                       <%= "checked" if (@pipeline.tone || "professional") == value %>
                       class="hidden">
                <span class="segmented-btn"><%= label %></span>
              </label>
            <% end %>
          </div>
        </div>

        <%# Formats %>
        <div class="field">
          <label class="field-label">Formats</label>
          <div class="format-grid" data-controller="format-tiles">
            <% [
              ["tweet_thread",     "Tweet thread",      "5–7 tweets, numbered, under 280 chars"],
              ["linkedin_post",    "LinkedIn post",     "Thoughtful, ends with a question"],
              ["blog_outline",     "Blog outline",      "Title, intro, 4–6 sections, conclusion"],
              ["email_newsletter", "Email newsletter",  "Subject, intro, body, clear CTA"]
            ].each do |value, title, desc| %>
              <label class="format-tile"
                     data-checked="<%= @pipeline.formats.include?(value) %>"
                     style="--tile-hue: <%= format_hue(value) %>"
                     data-action="click->format-tiles#toggle">
                <input type="checkbox" name="pipeline[formats][]" value="<%= value %>"
                       <%= "checked" if @pipeline.formats.include?(value) %>
                       class="hidden">
                <div class="format-tile-icon"><%= format_icon(value) %></div>
                <div class="format-tile-body">
                  <div class="format-tile-title"><%= title %></div>
                  <div class="format-tile-desc"><%= desc %></div>
                </div>
                <div class="format-tile-check">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M4 12l5 5 11-12"/></svg>
                </div>
              </label>
            <% end %>
          </div>
        </div>

        <%# Footer %>
        <div class="flex items-center justify-between">
          <span class="field-hint">One background job per format. You can leave this page — results are saved.</span>
          <%= submit_tag "Generate", class: "btn btn-primary btn-lg" %>
        </div>

      </div>
    <% end %>
  </div>
</div>
