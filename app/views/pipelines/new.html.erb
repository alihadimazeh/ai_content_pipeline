<div>
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
  </svg>
</div>
<div class="max-w-xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">New Pipeline</h1>

  <%= form_with url: pipelines_path, class: "space-y-6" do |f| %>
    <% if @pipeline.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded p-4 text-red-700 text-sm">
        <ul class="list-disc list-inside space-y-1">
          <% @pipeline.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= label_tag "pipeline[topic]", "Topic", class: "block text-sm font-medium mb-1" %>
      <%= text_field_tag "pipeline[topic]", @pipeline.topic, placeholder: "e.g. the benefits of walking meetings", class: "w-full border rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-black" %>
    </div>

    <div>
      <p class="block text-sm font-medium mb-2">Formats</p>
      <div class="space-y-2">
        <% { "tweet_thread" => "Tweet Thread", "linkedin_post" => "LinkedIn Post", "blog_outline" => "Blog Outline", "email_newsletter" => "Email Newsletter" }.each do |value, label| %>
          <label class="flex items-center gap-2 text-sm">
            <%= check_box_tag "pipeline[formats][]", value, @pipeline.formats.include?(value), class: "rounded" %>
            <%= label %>
          </label>
        <% end %>
      </div>
    </div>

    <%= submit_tag "Generate Content", class: "bg-black text-white px-5 py-2 rounded hover:bg-gray-800 cursor-pointer" %>
  <% end %>
</div>